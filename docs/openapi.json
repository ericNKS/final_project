                  "$ref": "#/components/schemas/FinancialTransaction"
                },
                {
                  "$ref": "#/components/schemas/RegistrationTransaction"
                }
              ],
              "discriminator": {
                "propertyName": "scenario",
                "mapping": {
                  "10k": "#/components/schemas/RegistrationTransaction",
                  "2m": "#/components/schemas/FinancialTransaction"
                }
              }
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Transactions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transactions"
        ],
        "title": "BatchRequest"
      },
      "Confirmation": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "cancelled"
            ],
            "title": "Status"
          },
          "executed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Executed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Confirmation",
        "examples": [
          {
            "executed_at": "2026-11-22T12:00:00-03:00",
            "status": "completed"
          },
          {
            "status": "cancelled"
          }
        ]
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "examples": [
          {
            "detail": "Identificador já registrado com conteúdo diferente"
          }
        ]
      },
      "FinancialAttributes": {
        "properties": {
          "tipo_transacao": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Tipo Transacao"
          },
          "saldo_anterior_pagador": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Saldo Anterior Pagador"
          },
          "saldo_anterior_recebedor": {
