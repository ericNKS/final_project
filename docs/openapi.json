        "additionalProperties": false,
        "type": "object",
        "required": [
          "tipo_transacao",
          "saldo_anterior_pagador",
          "saldo_anterior_recebedor"
        ],
        "title": "FinancialAttributes"
      },
      "FinancialTransaction": {
        "properties": {
          "external_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "External Id",
            "examples": [
              "pix-demo-001"
            ]
          },
          "payer_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Payer Id",
            "description": "Identificador opaco/pseudonimizado; não enviar CPF ou nome"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At",
            "examples": [
              "2026-11-22T12:00:00-03:00"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "150.00"
            ]
          },
          "scenario": {
            "type": "string",
            "const": "2m",
            "title": "Scenario"
          },
          "attributes": {
            "$ref": "#/components/schemas/FinancialAttributes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_id",
          "payer_id",
          "occurred_at",
          "amount",
          "scenario",
          "attributes"
        ],
        "title": "FinancialTransaction",
        "examples": [
          {
            "amount": "150.00",
            "attributes": {
              "saldo_anterior_pagador": "1000.00",
              "saldo_anterior_recebedor": "500.00",
              "tipo_transacao": "chave_pix"
            },
            "external_id": "pix-demo-001",
            "occurred_at": "2026-11-22T12:00:00-03:00",
            "payer_id": "payer-opaque-001",
            "scenario": "2m"
          }
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
